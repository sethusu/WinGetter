<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Try a different silent switch"
        Height="520" Width="640"
        MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Silent install failed - try another switch" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" x:Name="SummaryText" Margin="0,8,0,8" Foreground="#5C6B7A" TextWrapping="Wrap"/>
    <TextBlock Grid.Row="2" x:Name="EngineText" Margin="0,0,0,10" Foreground="#1B2A41" TextWrapping="Wrap"/>

    <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#D8DEE9" BorderThickness="1" Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="CandidatesPanel"/>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="32" Margin="0,0,8,0"/>
      <Button x:Name="TryAgainButton" Content="Try again" Width="120" Height="32" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
