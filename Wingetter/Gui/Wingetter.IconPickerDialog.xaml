<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Application Icon"
        Height="460" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Choose the best icon for Intune" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" x:Name="IconSummaryText" Margin="0,8,0,12" Foreground="#5C6B7A" TextWrapping="Wrap"/>

    <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#D8DEE9" BorderThickness="1" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="CandidatesPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="KeepCurrentButton" Content="Keep Current" Width="110" Height="32" Margin="0,0,8,0"/>
      <Button x:Name="UseSelectedButton" Content="Use Selected Icon" Width="140" Height="32" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
